# Signal Engine configuration (copy to .env and adjust)
# Never commit .env — it is gitignored.

# Optional: enables LLM profiling/intent layers (issue #10/#11).
# Without it the engine runs fully deterministic.
ANTHROPIC_API_KEY=

# Optional: any OpenAI-compatible endpoint as alternative provider.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Politeness: minimum seconds between Reddit requests.
PACE_SECONDS=45

# Minutes between scheduled fetch runs (cron cadence).
FETCH_WINDOW_MIN=30

# Only pull comment feeds for posts younger than this many hours.
COMMENT_MAX_AGE_H=48

# Hard monthly LLM spend cap in USD.
MONTHLY_LLM_BUDGET=25.0

# Dashboard port (loopback only).
PORT=7788

# SQLite path relative to repo root.
DB_PATH=data/engine.db
